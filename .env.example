# Cloudflare credenciales (obligatorias para generar)
# Token: dash.cloudflare.com -> My Profile -> API Tokens -> Create Token
#        Permiso requerido: Account -> Workers AI -> Read
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Carpeta de salida. Por defecto: %USERPROFILE%\Downloads
# IMAGE_OUT_DIR=C:\Users\HP\Downloads

# Modelo por defecto: flux-2-klein-4b | sd15-img2img
# IMAGE_FORGE_DEFAULT_MODEL=flux-2-klein-4b

# Nombre del campo multipart para la imagen (ajustable si Cloudflare lo cambia)
# IMAGE_FORGE_MULTIPART_IMAGE_FIELD=input_image

# Guardas de consumo
# IMAGE_FORGE_MAX_IMAGES_PER_CALL=4
# IMAGE_FORGE_MAX_INPUT_MB=10
# IMAGE_FORGE_WARN_NEURONS=8000
# IMAGE_FORGE_HARD_NEURONS=9500
# IMAGE_FORGE_TIMEOUT_MS=90000

# Historial de generaciones (JSONL)
# IMAGE_FORGE_HISTORY=C:\Users\HP\.image-forge\history.jsonl
